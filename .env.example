# ===== LLM =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_REASONING_MODEL=claude-opus-4-6
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# ===== 한국투자증권 KIS Open API =====
# https://apiportal.koreainvestment.com/
KIS_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIS_ACCOUNT_NO=12345678-01
KIS_ENV=paper  # paper | live

# ===== Data sources =====
DART_API_KEY=your_opendart_api_key
ECOS_API_KEY=your_ecos_api_key

# ===== Runtime =====
MAIS_DATA_DIR=./data_store
MAIS_LOG_LEVEL=INFO
MAIS_TZ=Asia/Seoul

# ===== Notifications (optional) =====
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 업비트 Open API (선택) =====
# 평소에는 대시보드 '설정' 탭에서 입력하세요 — data_store/ 아래에 암호화 저장됩니다.
# 아래 변수는 헤드리스/CI 실행용 예비 경로입니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# 설정하면 암호화 키를 디스크에 저장하지 않고 이 문구에서 유도합니다.
UPBIT_KEY_PASSPHRASE=
