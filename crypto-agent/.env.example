# === Trading mode ===
# dry   = no orders, no LLM cost beyond one sample run
# paper = Binance testnet
# live  = real Binance spot (only after P5 passes)
TRADING_MODE=dry

# === Capital ===
INITIAL_CAPITAL_USDT=1000
BASE_CURRENCY=USDT

# === Anthropic ===
ANTHROPIC_API_KEY=
AGENT_MODEL_FAST=claude-sonnet-4-6
AGENT_MODEL_STRONG=claude-opus-4-6
ANTHROPIC_DAILY_BUDGET_USD=5

# === Binance ===
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# === Free-tier data sources ===
CRYPTOPANIC_API_KEY=
FRED_API_KEY=
# CoinGecko free tier and DefiLlama need no key.

# === Infra ===
POSTGRES_DSN=postgresql+psycopg://crypto:crypto@localhost:5432/crypto
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# === Risk guardrails (percent, not fraction) ===
MAX_POSITION_PCT=25
MIN_CORE_PCT=40
STOP_LOSS_PCT=8
DAILY_LOSS_HALT_PCT=3
WEEKLY_LOSS_REDUCE_PCT=7
MDD_CIRCUIT_BREAKER_PCT=15

# === Observability ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
